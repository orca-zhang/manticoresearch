2026-11-04T09:45:23.7315043Z DIMS=${DIMS:-128}
2026-11-04T09:45:23.7315512Z SCHEMA="id bigint, c text, e float_vector knn_type='hnsw' knn_dims='$DIMS' hnsw_similarity='cosine' quantization='8bit'"
2026-11-04T09:45:23.7316003Z VEC="("
2026-11-04T09:45:23.7316191Z sep=""
2026-11-04T09:45:23.7316400Z for _ in $(seq 1 "$DIMS"); do
2026-11-04T09:45:23.7316644Z   VEC="${VEC}${sep}0.1"
2026-11-04T09:45:23.7316867Z   sep=","
2026-11-04T09:45:23.7317307Z done
2026-11-04T09:45:23.7317600Z VEC="${VEC})"
2026-11-04T09:45:23.7317920Z mysqlq() { mysql -h0 -P9306 --batch --raw --skip-column-names -e "$1"; }
2026-11-04T09:45:23.7318288Z mysqlq "DROP TABLE IF EXISTS t__old"
2026-11-04T09:45:23.7318557Z mysqlq "DROP TABLE IF EXISTS t"
2026-11-04T09:45:23.7318865Z mysqlq "CREATE TABLE t ($SCHEMA) engine='columnar'"
2026-11-04T09:45:23.7319464Z for f in $(seq 1 "$FLUSHES"); do
2026-11-04T09:45:23.7319968Z   sql="/tmp/issue-4697-insert-$f.sql"
2026-11-04T09:45:23.7320377Z   : > "$sql"
2026-11-04T09:45:23.7320776Z   for i in $(seq 1 "$ROWS_PER_FLUSH"); do
2026-11-04T09:45:23.7321231Z     id=$((f*ROWS_PER_FLUSH+i))
2026-11-04T09:45:23.7322051Z     printf "INSERT INTO t (id,c,e) VALUES (%d,'x',%s);\n" "$id" "$VEC" >> "$sql"
2026-11-04T09:45:23.7322700Z   done
2026-11-04T09:45:23.7323177Z   mysql -h0 -P9306 --batch --raw --skip-column-names < "$sql" >/dev/null
2026-11-04T09:45:23.7323825Z   mysqlq "FLUSH RAMCHUNK t" >/dev/null
2026-11-04T09:45:23.7324146Z done
2026-11-04T09:45:23.7324343Z end=$((SECONDS+30))
2026-11-04T09:45:23.7324604Z while [ $SECONDS -lt $end ]; do
