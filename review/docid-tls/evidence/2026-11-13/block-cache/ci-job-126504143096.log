2026-11-04T09:45:08.6228254Z show_shards() {
2026-11-04T09:45:08.6228613Z 	# Capture the whole SHOW CREATE TABLE output: the render is multi-line, so the agent=
2026-11-04T09:45:08.6229259Z 	# clauses live on a later line than "Create Table:" — filtering to that line drops them.
2026-11-04T09:45:08.6229755Z 	shards=$(mysql -h0 -P$1 -e "show create table $2 option force=1\G")
2026-11-04T09:45:08.6230109Z 	(
2026-11-04T09:45:08.6230299Z 		# Handle local shards
2026-11-04T09:45:08.6230912Z 		echo "$shards" | grep -oP "local='[^']*'" | sed "s/local='//g; s/'//g" | tr ',' '\n' | while read -r tbl; do
2026-11-04T09:45:08.6231385Z 			[ -n "$tbl" ] && echo "$tbl: local"
2026-11-04T09:45:08.6231641Z 		done
2026-11-04T09:45:08.6232000Z 		# Handle agent shards. Strip the [retry_count=...,ha_strategy=...] options suffix so all
2026-11-04T09:45:08.6232532Z 		# mirrors of a shard group under the same table name instead of a polluted awk key.
2026-11-04T09:45:08.6233305Z 		echo "$shards" | grep -oP "agent='[^']*'" | sed "s/agent='//g; s/'//g; s/\[[^]]*\]//g" | tr '|' '\n' | awk -F: '{agents[$3] = agents[$3] ? agents[$3] " " $1 ":" $2 : $1 ":" $2} END {for (t in agents) print t ": " agents[t]}'
2026-11-04T09:45:08.6234038Z 	) | sort
2026-11-04T09:45:08.6234216Z }
