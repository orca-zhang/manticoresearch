+TEST_P ( DocstoreBlockCacheTest, SecondTouchAdmissionAndIndexReplacement )
+{
+	ShutdownDocstore();
+	InitDocstore ( 16*1024*1024, GetParam() );
+	Write ( 0, 1, 256, 128 );
+	auto pStore = Open ( 0, 840 );
+	ASSERT_TRUE(pStore);
