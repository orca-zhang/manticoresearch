+	for ( RowID_t i=0; i<4094; ++i )
+		dPairs.Add ( { (DocID_t)(i*2), (i*37)%4096 } );
+	dPairs.Add ( { INT64_MIN, (4094*37)%4096 } );
+	dPairs.Add ( { -1, (4095*37)%4096 } );
+	CSphString sError;
+	ASSERT_TRUE ( WriteDocidLookup ( m_sFile, dPairs, sError ) );
